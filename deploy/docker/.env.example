# Copy to an untracked .env; run commands from repository root.
# Local review build. Official versioned registry image is not activated yet.
MNEMOSYNE_IMAGE=mnemosyne-mcp:local
MNEMOSYNE_VERSION=dev
MNEMOSYNE_REVISION=unknown
# Generate THREE unique secrets: python3 -c 'import secrets; print(secrets.token_hex(32))'
MNEMOSYNE_MCP_TOKENS='{"hermes":"REPLACE_HERMES","codex":"REPLACE_CODEX","claude-code":"REPLACE_CLAUDE_CODE"}'
MNEMOSYNE_MCP_ALLOWED_HOSTS=mnemosyne.home.arpa
MNEMOSYNE_BIND_IP=
MNEMOSYNE_PROXY_NETWORK=
MNEMOSYNE_HOSTNAME=mnemosyne.home.arpa
MNEMOSYNE_CADDY_BIND_IP=
MNEMOSYNE_CADDYFILE=./deploy/docker/Caddyfile.lan
